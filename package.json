{
	"name": "my-inbox",
	"version": "1.0.0",
	"description": "Adds a ribbon icon that opens a chosen base listing your incoming notes.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"bases",
		"inbox"
	],
	"author": "Vlad Kostyanetsky",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.19.0",
		"@eslint/json": "^0.10.0",
		"@types/node": "^22.10.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.19.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.20.0"
	}
}
